{
  "name": "entropy-tutor-mvp",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "dev": "pnpm --parallel --filter @mvp/web --filter @mvp/api dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm --filter @mvp/shared build && pnpm -r typecheck",
    "test": "pnpm --filter @mvp/shared build && pnpm -r test",
    "test:e2e": "pnpm --filter @mvp/shared build && pnpm --filter @mvp/api build && DEMO_SEED=true pnpm seed && playwright test",
    "prisma:generate": "prisma generate --schema prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema prisma/schema.prisma",
    "seed": "tsx prisma/seed.ts",
    "worker": "pnpm --filter @mvp/api worker"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^22.20.5",
    "eslint": "^9.39.5",
    "prettier": "^3.10.1",
    "prisma": "6.19.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "argon2": "0.45.2",
    "zod": "4.6.7"
  }
}
