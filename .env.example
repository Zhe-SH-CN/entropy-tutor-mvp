# Local demo only. Replace all secrets before a shared deployment.
DATABASE_URL=postgresql://mvp:mvp@127.0.0.1:5432/entropy_tutor
POSTGRES_USER=mvp
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
POSTGRES_DB=entropy_tutor
APP_ORIGIN=http://localhost:3000
# Web server uses this for the same-origin /api/v1 reverse proxy; inside Compose use http://api:3001.
API_ORIGIN=http://localhost:3001
WEB_PORT=3000
API_PORT=3001
SESSION_SECRET=replace-with-64-random-hex-characters
COOKIE_SECURE=false
AI_MODE=mock
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
BYOK_MASTER_KEY=replace-with-32-byte-random-hex
PAYMENT_WEBHOOK_SECRET=replace-with-random-webhook-secret
DEMO_SEED=false
